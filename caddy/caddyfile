# =========================================================
# 🌐 Global Classifier - Caddy Reverse Proxy Configuration
# Domain: global-classifier-dev.rootcode.software
# Network: bykstack
# =========================================================

(common) {
    encode gzip
    log {
        output file /var/log/caddy/{host}.log {
            roll_size 5MB
            roll_keep 5
        }
    }
    tls {
        issuer acme
    }
}

# ------------------- FRONTEND -------------------
gui.global-classifier-dev.rootcode.software {
    import common
    reverse_proxy gui:3001
}

# ------------------- RUUTER ---------------------
ruuter-public.global-classifier-dev.rootcode.software {
