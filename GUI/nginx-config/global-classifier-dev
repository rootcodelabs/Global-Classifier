server {
    listen 80;
    server_name global-classifier-dev.rootcode.software;

    # --- Redirect root to GUI ---
    location = / {
        return 301 /gui/;
    }

    # --- Common proxy settings (include everywhere) ---
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # --- GUI (React app) ---
    location /gui/ {
        proxy_pass http://gui:3001/;
    }

    # --- Ruuter Public ---
    location /ruuter-public/ {
        proxy_pass http://ruuter-public:8086/;
    }

    # --- Ruuter Private ---
    location /ruuter-private/ {
        proxy_pass http://ruuter-private:8088/;
    }

    # --- Data Mapper ---
    location /data-mapper/ {
        proxy_pass http://data-mapper:3000/;
    }

    # --- TIM (may use WebSockets for updates) ---
    location /tim/ {
        proxy_pass http://tim:8085/;
    }

    # --- Authentication Layer ---
    location /auth/ {
        proxy_pass http://authentication-layer:3004/;
    }

    # --- RESQL ---
    location /resql/ {
        proxy_pass http://resql:8082/;
    }

    # --- Notifications Node (WebSockets enabled) ---
    location /notifications/ {
        proxy_pass http://notifications-node:4040/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }

    # --- Grafana (uses WebSockets for live updates) ---
    location /grafana/ {
        proxy_pass http://grafana:3000/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }

    # --- Loki (optional) ---
    location /loki/ {
        proxy_pass http://loki:3100/;
    }

    # --- Mlflow Tracking UI ---
    location /mlflow/ {
        proxy_pass http://mlflow:5000/;
    }

    # --- MinIO Console ---
    location /minio/ {
        proxy_pass http://minio:9001/;
    }

    # --- OpenSearch ---
    location /opensearch/ {
        proxy_pass http://opensearch-node:9200/;
    }

    # --- OpenSearch Dashboards (Kibana-like UI, WebSockets) ---
    location /dashboards/ {
        proxy_pass http://opensearch-dashboards:5601/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }

    # --- Global CORS settings ---
    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH";
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-API-Key";
        add_header Access-Control-Max-Age 1728000;
        add_header Content-Type "text/plain charset=UTF-8";
        add_header Content-Length 0;
        return 204;
    }

    add_header Access-Control-Allow-Origin *;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH";
    add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-API-Key";
    add_header Access-Control-Expose-Headers "Content-Length,Content-Range";
}
