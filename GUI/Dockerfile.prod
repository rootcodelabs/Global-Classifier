FROM node:22.0.0-alpine AS build
WORKDIR /app

# Copy package files for dependency installation
COPY package.json package-lock.json* ./

# Install dependencies for production build
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build the application for production
RUN npm run build

# Production stage with lightweight web server
FROM nginx:alpine AS production

# Copy built assets to nginx
COPY --from=build /app/build /usr/share/nginx/html

# Copy custom nginx configuration for Global Classifier
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 (standard for nginx)
EXPOSE 80

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]