name: "post_processing"
backend: "python"
max_batch_size: 32
input [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [-1]
  },
  {
    name: "top_k"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  }
]
output [
  {
    name: "TOP_K_PREDICTIONS"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 100
}